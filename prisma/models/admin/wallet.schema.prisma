enum UsageKind {
  LINE_AI_REPLY // AI ตอบลูกค้าใน LINE OA
  ADMIN_AI_QUERY // แอดมินถาม AI หลังบ้าน
  EMBEDDING // สร้าง vector ให้ AnswerPattern
  LINE_PUSH_MESSAGE // ค่าส่งข้อความ LINE (ไม่ใช่ token)
}

enum LedgerType {
  TOPUP
  DEBIT
  REFUND
  ADJUSTMENT
  EXPIRE
}

enum CreditTopupStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

model CreditWallet {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @unique @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  balanceCredit       Decimal @default(0) @db.Decimal(20, 6)
  reservedCredit      Decimal @default(0) @db.Decimal(20, 6) // จองระหว่างรอ provider ตอบ
  lifetimeTopupCredit Decimal @default(0) @db.Decimal(20, 6)
  lifetimeSpentCredit Decimal @default(0) @db.Decimal(20, 6)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger  CreditLedger[]
  budgets CreditBudget[]

  @@unique([id, companyId]) // เผื่อทำ composite FK ตอนขึ้น multi-tenant
  @@map("credit_wallets")
}

model CreditBudget {
  id       String       @id @default(uuid()) @db.Uuid
  walletId String       @db.Uuid
  wallet   CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  kind     UsageKind
  scopeKey String    @default("*") @db.VarChar(64)

  limitCredit    Decimal? @db.Decimal(20, 6)
  usedCredit     Decimal  @default(0) @db.Decimal(20, 6)
  /// Credit held by provider calls that have not settled yet.
  reservedCredit Decimal  @default(0) @db.Decimal(20, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([walletId, kind, scopeKey])
  @@map("credit_budgets")
}

model CreditLedger {
  id       String       @id @default(uuid()) @db.Uuid
  walletId String       @db.Uuid
  wallet   CreditWallet @relation(fields: [walletId], references: [id])

  type               LedgerType
  amountCredit       Decimal    @default(0) @db.Decimal(20, 6) // + เข้า, - ออก
  balanceAfterCredit Decimal    @default(0) @db.Decimal(20, 6)

  kind         UsageKind?
  usageEventId String?       @unique @db.Uuid
  usageEvent   AiUsageEvent? @relation(fields: [usageEventId], references: [id])

  /// กันหักซ้ำตอน retry — "usage:<id>" | "topup:<paymentId>"
  idempotencyKey String  @unique @db.VarChar(255)
  note           String? @db.Text

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([walletId, kind, createdAt])
  @@map("credit_ledger")
}

model CreditTopupHistory {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @db.Uuid
  company   Company     @relation(fields: [companyId], references: [id])
  type      PaymentType @default(Slip)

  /// Nullable only for records created before exchange-rate top-ups existed.
  exchangeRateId String?             @db.Uuid
  exchangeRate   CreditExchangeRate? @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  packagePriceId String?             @db.Uuid
  packagePrice   CreditPackagePrice? @relation(fields: [packagePriceId], references: [id], onDelete: Restrict)
  paidAmount     Decimal?            @db.Decimal(20, 6)
  creditAmount   Decimal             @db.Decimal(20, 6)
  slipImage      String              @db.VarChar(500)

  status CreditTopupStatus @default(PENDING)

  requestedById String      @db.Uuid
  requestedBy   AdminMember @relation("CreditTopupRequestedBy", fields: [requestedById], references: [id])

  approvedById String?      @db.Uuid
  approvedBy   AdminMember? @relation("CreditTopupApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  rejectedById String?      @db.Uuid
  rejectedBy   AdminMember? @relation("CreditTopupRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([exchangeRateId])
  @@index([packagePriceId])
  @@map("credit_topups")
}
