model AdminMember {
  id        String    @id @default(uuid()) @db.Uuid
  username  String    @unique @db.VarChar(100)
  password  String
  firstname String    @db.VarChar(100)
  lastname  String    @db.VarChar(100)
  email     String    @unique @db.VarChar(255)
  phone     String    @unique @db.VarChar(30)
  image     String?
  role      AdminRole
  aiEnabled Boolean   @default(true)

  /// The tenant this admin administers. Every company-owned query scopes to it,
  /// so a null value can only read and write the legacy unscoped rows.
  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatRooms    AdminChatRoom[]
  chatRequests AdminChatRequest[]
  aiUsage      AiUsageEvent[]

  sentLineMessages LineChatHistory[]

  richMenuTemplates RichMenuTemplate[]

  requestedCreditTopupHistories CreditTopupHistory[] @relation("CreditTopupRequestedBy")
  approvedCreditTopupHistories  CreditTopupHistory[] @relation("CreditTopupApprovedBy")
  rejectedCreditTopupHistories  CreditTopupHistory[] @relation("CreditTopupRejectedBy")

  @@index([companyId])
  @@map("adminMember")
}
