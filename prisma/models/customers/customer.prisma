enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum CommerceChannel {
  LINE
  FACEBOOK
  WEB
}

model Customer {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @db.Uuid
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tenantId  String?        @db.Uuid
  memberId  String?        @db.Uuid
  member    Member?        @relation(fields: [memberId], references: [uuid], onDelete: Restrict)
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  identities     ChannelIdentity[]
  lineMembers    LineMember[]
  channelContacts ChannelContact[]
  linkChallenges AccountLinkChallenge[]

  @@unique([id, companyId])
  @@unique([companyId, memberId])
  @@index([companyId, tenantId, status])
  @@map("customers")
}

model ChannelIdentity {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @db.Uuid
  customerId     String          @db.Uuid
  customer       Customer        @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  channel        CommerceChannel
  connectionKey  String          @db.VarChar(100)
  externalUserId String          @db.VarChar(255)
  createdAt      DateTime        @default(now())

  redeemedChallenges AccountLinkChallenge[]

  @@unique([id, companyId])
  @@unique([companyId, channel, connectionKey, externalUserId], map: "channelIdentities_namespace_key")
  @@index([customerId, companyId])
  @@map("channelIdentities")
}

/// Internal authenticated channel commands only; raw tokens are never persisted.
model AccountLinkChallenge {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @db.Uuid
  customerId         String           @db.Uuid
  customer           Customer         @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  tokenHash          String           @unique @db.VarChar(64)
  expiresAt          DateTime
  consumedAt         DateTime?
  redeemedIdentityId String?          @db.Uuid
  redeemedIdentity   ChannelIdentity? @relation(fields: [redeemedIdentityId, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@index([companyId, expiresAt])
  @@map("accountLinkChallenges")
}
