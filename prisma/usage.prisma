enum UsageKind {
  LINE_AI_REPLY // AI ตอบลูกค้าใน LINE OA
  ADMIN_AI_QUERY // แอดมินถาม AI หลังบ้าน
  EMBEDDING // สร้าง vector ให้ AnswerPattern
  LINE_PUSH_MESSAGE // ค่าส่งข้อความ LINE (ไม่ใช่ token)
}

enum LedgerType {
  TOPUP
  DEBIT
  REFUND
  ADJUSTMENT
  EXPIRE
}

enum CreditTopupStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

model AiModelPricing {
  id       String         @id @default(uuid()) @db.Uuid
  provider AiProviderName
  model    String         @db.VarChar(150)

  inputCostThbPerMillTokens       Decimal  @default(0) @db.Decimal(20, 6)
  outputCostThbPerMillTokens      Decimal  @default(0) @db.Decimal(20, 6)
  cachedInputCostThbPerMillTokens Decimal? @db.Decimal(20, 6)
  cacheWriteCostThbPerMillTokens  Decimal? @db.Decimal(20, 6)

  inputCreditPerMillTokens       Decimal  @default(0) @db.Decimal(20, 6)
  outputCreditPerMillTokens      Decimal  @default(0) @db.Decimal(20, 6)
  cachedInputCreditPerMillTokens Decimal? @db.Decimal(20, 6)
  cacheWriteCreditPerMillTokens  Decimal? @db.Decimal(20, 6)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  usageEvents AiUsageEvent[]

  @@unique([provider, model, effectiveFrom])
  @@index([provider, model, effectiveFrom, effectiveTo])
  @@map("ai_model_pricing")
}

model AiUsageEvent {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  kind      UsageKind

  provider AiProviderName
  model    String         @db.VarChar(150)

  inputTokens       Int @default(0)
  cachedInputTokens Int @default(0)
  cacheWriteTokens  Int @default(0)
  outputTokens      Int @default(0) // รวม reasoning/thoughts แล้ว

  costThb       Decimal @default(0) @db.Decimal(20, 6) // ต้นทุนจริง — ไม่โชว์ลูกค้า
  chargedCredit Decimal @default(0) @db.Decimal(20, 6) // เครดิตที่หัก (1 credit = 1e6)

  pricingId String?         @db.Uuid
  pricing   AiModelPricing? @relation(fields: [pricingId], references: [id])

  adminMemberId String?      @db.Uuid
  adminMember   AdminMember? @relation(fields: [adminMemberId], references: [id], onDelete: SetNull)

  /// ไม่ผูก FK — เป็น log ไม่ควรบล็อกการลบ conversation/member
  lineMemberId   String? @db.Uuid
  conversationId String? @db.Uuid

  status            String  @default("success") @db.VarChar(20) // success | failed | timeout
  errorCode         String? @db.VarChar(100)
  latencyMs         Int?
  providerRequestId String? @db.VarChar(255)

  createdAt DateTime @default(now())

  ledgerEntry CreditLedger?

  @@index([companyId, createdAt])
  @@index([companyId, kind, createdAt])
  @@index([adminMemberId, createdAt])
  @@index([provider, model, createdAt])
  @@map("ai_usage_events")
}

model CreditWallet {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @unique @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  balanceCredit       Decimal @default(0) @db.Decimal(20, 6)
  reservedCredit      Decimal @default(0) @db.Decimal(20, 6) // จองระหว่างรอ provider ตอบ
  lifetimeTopupCredit Decimal @default(0) @db.Decimal(20, 6)
  lifetimeSpentCredit Decimal @default(0) @db.Decimal(20, 6)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger       CreditLedger[]
  budgets      CreditBudget[]

  @@unique([id, companyId]) // เผื่อทำ composite FK ตอนขึ้น multi-tenant
  @@map("credit_wallets")
}

model CreditBudget {
  id       String       @id @default(uuid()) @db.Uuid
  walletId String       @db.Uuid
  wallet   CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  kind     UsageKind
  scopeKey String    @default("*") @db.VarChar(64)

  limitCredit    Decimal? @db.Decimal(20, 6)
  usedCredit     Decimal  @default(0) @db.Decimal(20, 6)
  /// Credit held by provider calls that have not settled yet.
  reservedCredit Decimal  @default(0) @db.Decimal(20, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([walletId, kind, scopeKey])
  @@map("credit_budgets")
}

model CreditLedger {
  id       String       @id @default(uuid()) @db.Uuid
  walletId String       @db.Uuid
  wallet   CreditWallet @relation(fields: [walletId], references: [id])

  type               LedgerType
  amountCredit       Decimal    @default(0) @db.Decimal(20, 6) // + เข้า, - ออก
  balanceAfterCredit Decimal    @default(0) @db.Decimal(20, 6)

  kind         UsageKind?
  usageEventId String?       @unique @db.Uuid
  usageEvent   AiUsageEvent? @relation(fields: [usageEventId], references: [id])

  /// กันหักซ้ำตอน retry — "usage:<id>" | "topup:<paymentId>"
  idempotencyKey String  @unique @db.VarChar(255)
  note           String? @db.Text

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([walletId, kind, createdAt])
  @@map("credit_ledger")
}

model CreditTopupHistory {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  type         PaymentType @default(Slip)
  creditAmount Decimal @db.Decimal(20, 6)
  slipImage    String  @db.VarChar(500)

  status CreditTopupStatus @default(PENDING)

  requestedById String      @db.Uuid
  requestedBy   AdminMember @relation("CreditTopupRequestedBy", fields: [requestedById], references: [id])

  approvedById String?      @db.Uuid
  approvedBy   AdminMember? @relation("CreditTopupApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  rejectedById String?      @db.Uuid
  rejectedBy   AdminMember? @relation("CreditTopupRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@map("credit_topups")
}
