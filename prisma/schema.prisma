generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CreditWalletType {
  LINE_MESSAGE
  AI_USAGE
  ADMIN_AI_QUERY
}

enum AdminRole {
  dev
  owner
  admin
}

enum LineChatSender {
  USER   @map("user")
  ADMIN  @map("admin")
  AI     @map("ai")
  SYSTEM @map("system")
}

enum LineChatMessageType {
  TEXT     @map("text")
  IMAGE    @map("image")
  STICKER  @map("sticker")
  POSTBACK @map("postback")
}

enum AiProviderScope {
  USER
  ADMIN
}

enum AiProviderName {
  GEMINI
  OPENAI
  ANTHROPIC
  MAXPLUS
}

enum AdminChatRole {
  USER
  ASSISTANT
}

/// One back-office AI chat thread ("room"), private to the admin who owns it.
model AdminChatRoom {
  id            String      @id @default(uuid()) @db.Uuid
  adminMemberId String      @db.Uuid
  adminMember   AdminMember @relation(fields: [adminMemberId], references: [id], onDelete: Cascade)

  title         String   @db.VarChar(255)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages AdminChatMessage[]
  requests AdminChatRequest[]

  @@index([adminMemberId, lastMessageAt])
  @@map("adminChatRooms")
}

model AdminChatMessage {
  id     String        @id @default(uuid()) @db.Uuid
  roomId String        @db.Uuid
  room   AdminChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  role    AdminChatRole
  content String        @db.Text

  /// Which provider/model produced an ASSISTANT message (null for USER turns).
  provider AiProviderName?
  model    String?         @db.VarChar(150)

  createdAt DateTime @default(now())

  requestAsUser      AdminChatRequest? @relation("AdminChatRequestUserMessage")
  requestAsAssistant AdminChatRequest? @relation("AdminChatRequestAssistantMessage")

  @@index([roomId, createdAt])
  @@map("adminChatMessages")
}

/// Durable HTTP idempotency and recovery record for an admin AI turn.
model AdminChatRequest {
  id                 String            @id @default(uuid()) @db.Uuid
  clientRequestId    String            @unique @db.Uuid
  adminMemberId      String            @db.Uuid
  adminMember        AdminMember       @relation(fields: [adminMemberId], references: [id], onDelete: Cascade)
  roomId             String            @db.Uuid
  room               AdminChatRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userMessageId      String            @unique @db.Uuid
  userMessage        AdminChatMessage  @relation("AdminChatRequestUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)
  assistantMessageId String?           @unique @db.Uuid
  assistantMessage   AdminChatMessage? @relation("AdminChatRequestAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  text               String            @db.Text
  status             String            @default("PENDING") @db.VarChar(20)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([adminMemberId, createdAt])
  @@index([roomId, createdAt])
  @@map("adminChatRequests")
}

// Singleton row — one instance of this app serves one company/LINE OA.
model Company {
  id          String @id @default(uuid()) @db.Uuid
  name        String @db.VarChar(255)
  companyType String @default("other") @db.VarChar(100)
  image       String @default("") @db.VarChar(500)

  messagesSentPeriod String @default("") @db.VarChar(7)
  messagesSentCount  Int    @default(0)

  creditWallet  CreditWallet?
  aiUsageEvents AiUsageEvent[]
  creditTopups  CreditTopupHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company")
}

model LineFollowerSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  date            DateTime @unique @db.Date
  followerCount   Int
  targetedReaches Int?
  blockCount      Int?
  createdAt       DateTime @default(now())

  @@map("lineFollowerSnapshots")
}

model AdminNotification {
  id String @id @default(uuid()) @db.Uuid

  /// LINE user id of the customer this notification is about (not a Member uuid).
  userId String? @db.VarChar(255)

  /// Everything the back office needs to act on this notification, including
  /// `conversationId` — the chat thread an admin opens by clicking it.
  /// Shape is validated by `notificationMetadataSchema`.
  metadata Json?

  type    String  @db.VarChar(50)
  title   String  @db.VarChar(255)
  message String? @db.Text
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("adminNotifications")
}

model AiSetting {
  id              String   @id @default(uuid()) @db.Uuid
  systemPrompt    String   @db.Text
  tone            String?  @db.VarChar(100)
  fallbackMessage String?  @db.Text
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  @@map("aiSettings")
}

model AiProviderSetting {
  id        String          @id @default(uuid()) @db.Uuid
  scope     AiProviderScope @unique
  provider  AiProviderName
  model     String          @db.VarChar(150)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("aiProviderSettings")
}

model AnswerPattern {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid

  title       String  @db.VarChar(255)
  description String? @db.Text
  category    String? @db.VarChar(100)
  intentKey   String? @db.VarChar(100)

  keywords         String[] @default([])
  questionExamples String[] @default([])

  answer   String @db.Text
  language String @default("th") @db.VarChar(10)

  priority Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  vector AnswerPatternVector?

  @@map("answerPattern")
}

model LineMember {
  id String @id @default(uuid()) @db.Uuid

  memberId String? @db.Uuid
  member   Member? @relation(fields: [memberId], references: [uuid], onDelete: SetNull)

  lineUserId    String  @unique
  displayName   String
  pictureUrl    String?
  statusMessage String?

  lastActiveAt    DateTime?
  profileSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation  LineConversation?
  chatHistories LineChatHistory[]

  @@index([memberId])
  @@index([lastActiveAt])
  @@map("lineMember")
}

model LineConversation {
  id              String              @id @default(uuid()) @db.Uuid
  lineMemberId    String              @unique @db.Uuid
  status          String              @default("open")
  lastMessage     String
  lastMessageType LineChatMessageType
  lastMessageAt   DateTime
  unreadCount     Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lineMember      LineMember          @relation(fields: [lineMemberId], references: [id])
  chatHistories   LineChatHistory[]

  @@index([lastMessageAt])
  @@index([status])
  @@map("lineConversation")
}

model LineChatHistory {
  id                  String              @id @default(uuid()) @db.Uuid
  conversationId      String              @db.Uuid
  lineMemberId        String              @db.Uuid
  sender              LineChatSender
  messageType         LineChatMessageType
  text                String?
  lineMessageId       String?             @unique
  replyToken          String?
  stickerPackageId    String?
  stickerId           String?
  stickerResourceType String?
  mediaUrl            String?
  postbackData        String?
  rawEvent            Json?
  sentStatus          String              @default("received")
  deliveryId          String?             @unique @db.Uuid

  sentByAdminId String?      @db.Uuid
  sentByAdmin   AdminMember? @relation(fields: [sentByAdminId], references: [id], onDelete: SetNull)

  createdAt    DateTime         @default(now())
  conversation LineConversation @relation(fields: [conversationId], references: [id])
  lineMember   LineMember       @relation(fields: [lineMemberId], references: [id])

  @@index([conversationId, createdAt])
  @@index([lineMemberId])
  @@index([sentByAdminId])
  @@map("lineChatHistory")
}

model AnswerPatternVector {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  answerPatternId String                      @db.Uuid
  embedding       Unsupported("vector(1536)")
  embeddingModel  String?                     @db.VarChar(100)
  active          Boolean                     @default(true)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @default(now())

  answerPattern AnswerPattern @relation(fields: [answerPatternId], references: [id], onDelete: Cascade)

  @@unique([answerPatternId])
  @@index([answerPatternId])
  @@index([active])
  @@map("answerPatternVector")
}

model ProcessedLineWebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  webhookEventId String    @unique
  processedAt    DateTime  @default(now())
  status         String    @default("COMPLETED")
  event          Json?
  leaseOwner     String?
  leaseUntil     DateTime?
  attempts       Int       @default(0)
  lastError      String?

  @@index([processedAt])
  @@index([status, leaseUntil])
  @@map("processedLineWebhookEvent")
}

// Durable outbound messages. IDs are retained as log references, not deletion blockers.
model LineDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  key            String    @unique
  lineUserId     String
  conversationId String    @db.Uuid
  lineMemberId   String    @db.Uuid
  adminMemberId  String?   @db.Uuid
  text           String
  replyToken     String?
  replyUntil     DateTime?
  context        Json?
  status         String    @default("PENDING")
  method         String    @default("REPLY")
  retryKey       String    @default(uuid()) @db.Uuid
  firstPushAt    DateTime?
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  leaseOwner     String?
  leaseUntil     DateTime?
  lastError      String?
  acceptedAt     DateTime?
  finalizedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@map("lineDelivery")
}

model AdminBootstrap {
  id        String   @id
  createdAt DateTime @default(now())

  @@map("adminBootstrap")
}
