model Member {
  uuid          String        @id @default(uuid()) @db.Uuid
  username      String        @unique
  password      String
  firstname     String
  lastname      String
  phone         String        @unique
  bankname      String
  banknumber    String        @unique
  statusaccount String        @default("pending")
  createdAt     DateTime      @default(now())
  payments      UserPayment[]
  lineMembers   LineMember[]

  @@index([createdAt])
  @@map("member")
}
