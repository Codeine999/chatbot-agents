{
  "rootDir": "../..",
  "testEnvironment": "node",
  "testRegex": "test/audit-core-logic-opus/.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "diagnostics": true
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "maxWorkers": 1,
  "setupFiles": [
    "<rootDir>/test/audit-core-logic-opus/silence-logs.ts"
  ]
}