        <mxCell id="t2" value="Intent routing (ซ้าย) และ hybrid retrieval (ขวา)" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1200" height="40" as="geometry"/></mxCell>

        <mxCell id="n1" value="ChatbotService.handleTextMessage(ChatRequest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="260" height="55" as="geometry"/></mxCell>
