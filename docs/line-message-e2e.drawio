        <mxCell id="r2" value="AnswerPattern cache (RAM)&#xa;สูงสุด 500 rows · refresh 240s · ไม่แตะ DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1010" y="185" width="320" height="60" as="geometry"/></mxCell>
