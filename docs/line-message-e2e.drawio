        <mxCell id="n10" value="action = ANSWER_KNOWLEDGE ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="360" y="820" width="240" height="90" as="geometry"/></mxCell>
