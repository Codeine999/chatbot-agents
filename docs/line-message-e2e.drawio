        <mxCell id="o5" value="CONTINUE_REGISTER&#xa;REGISTRATION · CLEAR (PII)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="750" width="230" height="60" as="geometry"/></mxCell>
