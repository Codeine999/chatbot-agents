        <mxCell id="r4" value="AnswerPattern DB (&lt;= 500 rows)&#xa;scorer ตัวเดียวกับ cache · DB ชนะ cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1010" y="365" width="320" height="60" as="geometry"/></mxCell>
