        <mxCell id="o1" value="defaultMessage()&#xa;SYSTEM · CLEAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="n3" value="len &gt; AI_MAX_MESSAGE_LENGTH (1000) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="270" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="o2" value="messageTooLong()&#xa;SYSTEM · EXCLUDE&#xa;(ตัดก่อน session และก่อนทุก AI call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="380" y="275" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="n4" value="UserSessionService.get(userId)&#xa;GETEX — sliding TTL 30 นาที" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="395" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="n5" value="RuleIntentService.detect(input)&#xa;→ IntentResult { intent, confidence, source:'RULE' }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="485" width="260" height="65" as="geometry"/></mxCell>
